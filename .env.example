# ============================================================
# اربط لي يا حب ❤️ (ERBOTLI) — Environment Variables
# لا تضع أي قيم حقيقية في هذا الملف. انسخه إلى .env.local وعبّه محليًا.
# Never commit real secrets. This file documents required vars only.
# ============================================================

# --- Database (PostgreSQL, production-ready) ---
DATABASE_URL="postgresql://user:password@localhost:5432/erbotli?schema=public"
# On Neon (or any auto-suspending serverless Postgres), add &connect_timeout=20 to the URL —
# the first query after idle time has to wait for the compute to wake up, and Prisma's default
# connect timeout is too short for that, which surfaces as a real (if transient) 500 on
# whichever page happens to be hit first after a period of inactivity.

# --- Auth ---
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TOKEN_TTL_HOURS="720"

# --- LLM Providers (model routing: cheap model for extraction, strong model for critic/fact-check) ---
# LLM_PROVIDER picks the backend explicitly: "anthropic" | "openai_compatible".
# Leave unset to auto-pick whichever below has credentials configured (Anthropic first).
LLM_PROVIDER=""

# Anthropic (api.anthropic.com, sk-ant-... keys)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_FAST="claude-haiku-4-5-20251001"
ANTHROPIC_MODEL_STRONG="claude-sonnet-5"

# Any OpenAI-compatible endpoint (OpenRouter, local Ollama/LM Studio, or another
# aggregator that speaks POST {base_url}/chat/completions). Vendor-neutral by design —
# swapping providers is an env change, never a code change in the agents.
OPENAI_COMPATIBLE_BASE_URL=""       # e.g. "https://openrouter.ai/api/v1"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL=""          # exact model name the provider expects
OPENAI_COMPATIBLE_MODEL_FAST=""     # optional: overrides OPENAI_COMPATIBLE_MODEL for the fast tier
OPENAI_COMPATIBLE_MODEL_STRONG=""   # optional: overrides OPENAI_COMPATIBLE_MODEL for the strong tier
OPENAI_COMPATIBLE_NAME=""           # optional: label shown in AiGeneration logs

# --- Retrieval / Search (for real-world fact grounding: sports, films, series, recent events) ---
# Required for Fact Checker + Connection Finder to ground claims in real sources.
# Without this key the pipeline runs in DEGRADED mode: only knowledge-base-backed
# connections are allowed, and the system will say "ما عندي مصدر كافي لهذا الربط."
SEARCH_API_KEY=""
SEARCH_PROVIDER="brave" # brave | serpapi | bing

# --- Billing (architecture is provider-agnostic — plug in later) ---
PAYMENT_PROVIDER="none" # none | stripe | moyasar | paytabs | hyperpay
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# --- App ---
NEXT_PUBLIC_APP_NAME="اربط لي يا حب"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
