// ============================================================
// اربط لي يا حب ❤️ (ERBOTLI) — Database Schema
// PostgreSQL. All tenant-scoped tables carry userId for isolation.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  locale       String   @default("ar")
  role         Role     @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile          Profile?
  preferences      Preference[]
  favoriteWorlds   FavoriteWorld[]
  favoriteTeams    FavoriteTeam[]
  favoritePlayers  FavoritePlayer[]
  favoriteMovies   FavoriteMovie[]
  favoriteShows    FavoriteShow[]
  favoriteAnime    FavoriteAnime[]
  favoriteGames    FavoriteGame[]
  favoriteCars     FavoriteCar[]
  favoriteMusic    FavoriteMusic[]
  favoritePeople   FavoritePerson[]
  documents        Document[]
  connectionFeedback ConnectionFeedback[]
  flashcards       Flashcard[]
  quizzes          Quiz[]
  quizAttempts     QuizAttempt[]
  studySessions    StudySession[]
  reviewItems      ReviewItem[]
  subscriptions    Subscription[]
  usageRecords     Usage[]
  aiGenerations    AiGeneration[]
  auditLogs        AuditLog[]
  gamification     GamificationProfile?
  permissionOverrides UserPermissionOverride[]
  assignedLeads    Lead[]     @relation("LeadAssignee")
  leadNotes        LeadNote[]

  @@index([email])
}

// STUDENT never enters /admin. Every other role is staff (the "Employee" concept reuses this
// same table — same auth/session machinery, discriminated by role — rather than a parallel
// identity table for a second class of account).
enum Role {
  STUDENT
  OWNER
  ADMIN
  SUPPORT
  SALES
  FINANCE
  ANALYST
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// ---------- Onboarding / Preferences ----------

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingComplete Boolean  @default(false)
  connectionStyles   String[] // stories | characters | events | cause_effect | comparisons | visual
  memoryProfileJson  Json?    // denormalized "USER MEMORY PROFILE" snapshot, rebuilt on preference change
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Preference {
  // key/value preference weights used by the Personalization Engine, e.g.
  // key="connection_type:character" value=20 ; key="world:football" value=30
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  weight    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

enum WorldCategory {
  SERIES
  MOVIES
  FOOTBALL
  GAMES
  ANIME
  CARS
  MUSIC
  PEOPLE
  CHARACTERS
  BOOKS
  DAILY_LIFE
}

model FavoriteWorld {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  WorldCategory
  createdAt DateTime      @default(now())

  @@unique([userId, category])
}

model FavoriteTeam {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  kind       String  @default("club") // club | national
  externalId String? // knowledge base / search provider id, for fact grounding
  @@index([userId])
}

model FavoritePlayer {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  externalId String?
  @@index([userId])
}

model FavoriteMovie {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  externalId   String?
  favoriteChars String[]
  @@index([userId])
}

model FavoriteShow {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  externalId    String?
  favoriteChars String[]
  rememberedBits String[]
  @@index([userId])
}

model FavoriteAnime {
  id            String @id @default(cuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  externalId    String?
  favoriteChars String[]
  @@index([userId])
}

model FavoriteGame {
  id            String @id @default(cuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  externalId    String?
  favoriteChars String[]
  @@index([userId])
}

model FavoriteCar {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String  // brand + model, e.g. "Nissan GT-R"
  externalId String?
  @@index([userId])
}

model FavoriteMusic {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String  // artist, song, or album title
  externalId String?
  @@index([userId])
}

model FavoritePerson {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String  // any public figure the user searched and picked
  externalId String?
  @@index([userId])
}

// ---------- Documents / Slides ----------

model Document {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     DocumentType
  textSizeKb   Int            // size of the client-extracted text, not the original file (no file ever reaches the server)
  status       DocumentStatus @default(UPLOADED)
  pageCount    Int?
  contentHash  String         // sha256 of extracted text, used to skip re-processing unchanged docs
  errorMessage String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  pages       DocumentPage[]
  concepts    Concept[]
  quizzes     Quiz[]
  studySessions StudySession[]

  @@index([userId])
  @@unique([userId, contentHash])
}

enum DocumentType {
  PDF
  PPT
  PPTX
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  OCR
  PARSING
  MAPPING_CONCEPTS
  FINDING_CONNECTIONS
  FACT_CHECKING
  GENERATING
  READY
  FAILED
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber Int
  rawText    String
  usedOcr    Boolean  @default(false)
  tables     Json?
  createdAt  DateTime @default(now())

  @@unique([documentId, pageNumber])
}

// ---------- Concepts & Connections ----------

model Concept {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title         String
  summary       String
  atomLabel     String   @default("") // the isolated short fact itself, unmodified: "7 mg"
  atomEmoji     String   @default("🧠") // single emoji representing the fact's kind
  importance    Int      @default(0) // 0-100, from "تحديد المعلومات المهمة للحفظ"
  conceptType   ConceptType @default(DEFINITION)
  sourcePageIds String[]
  orderIndex    Int      // sequence position for mind-map / cause-effect chains
  relatedToJson Json?    // adjacency: [{ conceptId, relation: "cause_effect"|"sequence"|"similar_term" }]
  createdAt     DateTime @default(now())

  connections Connection[]
  flashcards  Flashcard[]
  quizQuestions QuizQuestion[]
  reviewItems ReviewItem[]

  @@index([documentId])
}

enum ConceptType {
  DEFINITION
  PROCESS
  CAUSE_EFFECT
  COMPARISON
  SEQUENCE
  TERMINOLOGY
}

model Connection {
  id               String   @id @default(cuid())
  conceptId        String
  concept          Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  associationLevel AssociationLevel // priority ladder: direct match is always tried before looser levels
  worldCategory    WorldCategory
  worldRef         String   // e.g. "Cristiano Ronaldo", "Real Madrid"
  atomEmoji        String   // e.g. "💉" — represents the fact itself (dose, half-life, term...)
  atomLabel        String   // the short fact as-is, unmodified: "7 mg", "8 hours"
  bridgeLine       String   // the ENTIRE mnemonic, as short as possible: "Ronaldo = 7"
  whyOneLiner      String   // one or two sentences max, only shown behind "ليش؟"
  claimType        ClaimType @default(ANALOGY) // FACT | ANALOGY | INTERPRETATION — never blur these
  score            Int      // 0-100 Connection Score, gates visibility at >= threshold
  scoreBreakdown   Json     // { directness, familiarity, simplicity, memorability, relevance, confusionRisk }
  status           ConnectionStatus @default(PENDING_CRITIC)
  rejectionReason  String?  // filled when Connection Critic rejects
  regenerationOf   String?  // previous Connection.id, for "اعد الربط" chain — never repeats the same angle
  createdAt        DateTime @default(now())

  sources  ConnectionSource[]
  feedback ConnectionFeedback[]

  @@index([conceptId])
  @@index([status])
}

// The priority ladder (item 6): always try the lowest number first — it's the strongest,
// most-instantly-understood bridge. Only fall to a higher level when the lower ones fail.
enum AssociationLevel {
  DIRECT_MATCH        // 1 — same literal number/value: "7 mg" -> "Ronaldo #7"
  PHONETIC            // 2 — sounds like something the user knows: "Metformin" -> "Metro"
  VISUAL              // 3 — shape/color/symbol resemblance
  FAMOUS_ASSOCIATION  // 4 — well-known fact about the interest: "10" -> "Messi"
  CONTEXTUAL          // 5 — an event/character/story the user knows with a matching pattern
}

enum ClaimType {
  FACT
  ANALOGY
  INTERPRETATION
}

enum ConnectionStatus {
  PENDING_CRITIC
  APPROVED
  REJECTED
  BELOW_THRESHOLD
  NO_CONNECTION_FOUND // system explicitly declined to invent one
}

model ConnectionSource {
  id           String   @id @default(cuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sourceType   SourceType
  url          String?
  title        String?
  confidence   Float    // 0-1, from retrieval/fact-checker
  evidenceSnippet String
  retrievedAt  DateTime @default(now())

  @@index([connectionId])
}

enum SourceType {
  KNOWLEDGE_BASE // curated, stable facts (classic films/shows/history)
  LIVE_SEARCH    // sports results, recent events — must be fetched, never memorized
  USER_PROVIDED
}

// ---------- Feedback / Personalization ----------

model ConnectionFeedback {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reaction       FeedbackReaction
  generatedClaim String   // snapshot of relationExplain at feedback time, for incorrect-claim audits
  note           String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([connectionId])
}

enum FeedbackReaction {
  LOVE
  LIKE
  NEUTRAL
  DISLIKE
  INCORRECT
}

// ---------- Flashcards / Quizzes / Study ----------

model Flashcard {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId  String
  concept    Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  front      String
  back       String
  connectionId String?
  createdAt  DateTime @default(now())

  reviewItems ReviewItem[]

  @@index([userId])
}

model Quiz {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title      String
  createdAt  DateTime @default(now())

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([userId])
}

model QuizQuestion {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  conceptId    String
  concept      Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  kind         QuizKind
  prompt       String
  choicesJson  Json?    // for MCQ
  correctAnswer String
  explanation  String

  @@index([quizId])
}

enum QuizKind {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  SCENARIO
  RECALL
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answersJson Json    // [{ questionId, given, correct }]
  scorePct   Float
  startedAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([userId])
}

model StudySession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  mode       String   @default("focus") // focus | quiz | flashcards
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  conceptsCovered Int @default(0)

  @@index([userId])
}

// Spaced repetition queue (SM-2-inspired)
model ReviewItem {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId    String?
  concept      Concept? @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  flashcardId  String?
  flashcard    Flashcard? @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(1)
  dueAt        DateTime @default(now())
  lastResult   ReviewResult?
  reviewCount  Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@index([userId, dueAt])
  @@unique([userId, conceptId])
  @@unique([userId, flashcardId])
}

enum ReviewResult {
  AGAIN
  HARD
  GOOD
  EASY
}

// ---------- Billing (provider-agnostic) ----------

model Plan {
  id            String   @id @default(cuid())
  code          String   @unique // FREE | PLUS | PRO
  nameAr        String
  nameEn        String
  priceMonthlyCents Int
  currency      String   @default("SAR")
  isActive      Boolean  @default(true)
  limitsJson    Json     // { maxDocuments, maxPagesPerDoc, maxConnectionsPerMonth, maxQuizzesPerMonth, studyMode, spacedRepetition, prioritySupport }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String
  plan              Plan     @relation(fields: [planId], references: [id])
  status            SubscriptionStatus @default(ACTIVE)
  provider          String?  // null while PAYMENT_PROVIDER=none ; stripe | moyasar | ...
  providerRef       String?  // external subscription id, opaque
  currentPeriodEnd  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Usage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  documents   Int      @default(0)
  pages       Int      @default(0)
  words       Int      @default(0)
  connections Int      @default(0)
  aiGenerations Int    @default(0)
  quizzes     Int      @default(0)

  @@unique([userId, periodStart])
}

model AiGeneration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent       String   // e.g. "connection_finder", "fact_checker"
  model       String
  inputTokens Int
  outputTokens Int
  costCents   Float
  latencyMs   Int
  cacheHit    Boolean  @default(false)
  success     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([agent])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metaJson  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- RBAC (Admin Back-Office) ----------

model Permission {
  id            String @id @default(cuid())
  key           String @unique // "users.view", "payments.refund", "owner_only_actions"...
  category      String          // groups the permission-matrix UI: "users" | "crm" | "billing"...
  descriptionAr String

  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]
}

// Role-level defaults. OWNER is not represented here — it always bypasses this table entirely
// (see src/lib/rbac.ts) since "Owner has full access" is a standing invariant, not a grant list.
model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

// Per-employee exception to their role's defaults — an explicit grant beyond the role, or an
// explicit revoke of something the role would normally allow. Always wins over the role default.
model UserPermissionOverride {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
}

// ---------- CRM ----------

enum LeadStage {
  LEAD
  CONTACTED
  TRIAL
  QUALIFIED
  PAID
  RETENTION
  CHURNED
}

enum LeadSource {
  INSTAGRAM
  TIKTOK
  X
  GOOGLE
  REFERRAL
  WEBSITE
  CAMPAIGN
  OTHER
}

model Lead {
  id            String     @id @default(cuid())
  name          String
  email         String?
  phone         String?
  source        LeadSource @default(OTHER)
  stage         LeadStage  @default(LEAD)
  potentialPlan String?    // FREE | PLUS | PRO — a guess at the plan they'd convert to, not a real Subscription
  valueCents    Int?       // estimated deal value, admin-entered — no real payment data backs this yet
  assignedToId  String?
  assignedTo    User?      @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastContactAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  notes LeadNote[]
  tasks LeadTask[]

  @@index([stage])
  @@index([assignedToId])
  @@index([source])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model LeadTask {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title     String
  dueAt     DateTime?
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([leadId])
}

// ---------- Gamification ----------

model GamificationProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp          Int      @default(0)
  level       Int      @default(1)
  streakDays  Int      @default(0)
  lastActiveDate DateTime?
  achievementsJson Json @default("[]")
  updatedAt   DateTime @updatedAt
}
